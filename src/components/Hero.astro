---
// Developer-first Knowledge Plane entry point. Data remains source-derived.
import prov from '../data/provenance.json';
import buildStatus from '../data/build-status.json';
import contracts from '../data/contracts.json';
import graph from '../data/graph.json';

const stats = [
  { n: String(contracts.contracts.length), l: 'Canonical contracts' },
  { n: String(graph.contract_graph.edges.length), l: 'Governance edges' },
  { n: String(graph.claim_graph.claims.length), l: 'Audited claims' },
  { n: '4', l: 'Truth clocks' },
];
const verified = buildStatus?.page_line ?? '';
---
<div class="ag-hero">
  <p class="ag-hero-meta">Knowledge Plane · {prov.index.semantic_version}</p>
  <h1>Build systems that can act. Verify what actually happened.</h1>
  <p class="lede">
    Repositories own truth. Governance owns boundaries. Evidence owns claim strength.
    This portal resolves those sources into one developer and research surface — it does not become their source of truth.
  </p>
  <div class="ag-hero-ctas">
    <a class="ag-btn" href="/developers/quickstart/">Start building →</a>
    <a class="ag-btn ghost" href="/platform/golden-mission/">Golden Mission</a>
    <a class="ag-btn ghost" href="/standards/contracts/">Contract Explorer</a>
    <a class="ag-btn ghost" href="/developers/api-reference/">API Reference</a>
  </div>
  <div class="ag-hero-stats" aria-label="Source-derived Knowledge Plane counts">
    {stats.map((s) => <div class="ag-stat"><b>{s.n}</b><span>{s.l}</span></div>)}
  </div>
  {verified && <p class="ag-live-note">{verified}</p>}
</div>