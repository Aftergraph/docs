---
// System grid for Platform — color-coded per system semantic.
const systems = [
  { name: 'AIE', role: 'authority semantics', repo: 'Aftergraph/aie', color: 'var(--ag-authority)', contracts: ['identity/1.0', 'brain.ns/1.0'] },
  { name: 'Trust Gateway', role: 'enforcement', repo: 'Aftergraph/trust-gateway', color: 'var(--ag-control)', contracts: ['policy.token/1.0', 'secret.ref/1.0'] },
  { name: 'WORKS', role: 'durable execution', repo: 'Aftergraph/works-execution', color: 'var(--ag-system)', contracts: ['shell.contracts/1.0', 'evidence.schema/1.1', 'kernel.budget/1.0'] },
  { name: 'Work Intelligence', role: 'API v0.2.0 (OpenAPI 3.1.0)', repo: 'Aftergraph/wi-backend', color: 'var(--ag-evidence)', contracts: [] },
  { name: 'Studio', role: 'operator experience', repo: 'Aftergraph/studio', color: 'var(--ag-decision)', contracts: ['consumes evidence.schema/1.1'] },
];
---
<div class="ag-systems">
  {systems.map((s) => (
    <div class="ag-system" style={`--sc:${s.color}`}>
      <h3>{s.name} <code>· {s.role}</code></h3>
      <p>{s.repo}</p>
      {s.contracts.length > 0 && <span class="contracts">{s.contracts.join(' · ')}</span>}
    </div>
  ))}
</div>